clc; clear; close all;
%--------------------------------------------------------------------------
% Input parameters     
% Borehole ellipticity file path.
input_filename = "../data/ST1_20210305_borehole_ellipticity_outputs/ellipticity_parameters_outlier_filtered_dz0.025m_borehole_trajectory.csv";
% Stress inversion output file path.
output_filename = "../data/ST1_20210305_stress_inversion_outputs/EllipseStressInv_dept.mat";
%--------------------------------------------------------------------------
input_filename = ["/Users/wangguangyu/Data/Geomechanics/BedrettoLab/Logs_CB1_20191010/20191010_ATV_CB1_up3_Ellipticity_NM_OriginalSamplingRate_MaskExcluded/ellipse_parameters_Outlier(FittingError>1mm)Filtered_MeanSubsampled_dz0.25m_borehole_trajectory.csv" 
                   "/Users/wangguangyu/Data/Geomechanics/BedrettoLab/Logs_CB2_20191021/20191021_CB2_SGR_ATV_up1_Ellipticity_NM_OriginalSamplingRate_MaskExcluded/ellipse_parameters_Outlier(FittingError>1mm)Filtered_MeanSubsampled_dz0.25m_borehole_trajectory.csv"
                   "/Users/wangguangyu/Data/Geomechanics/BedrettoLab/Logs_CB3_20200730/2020_07_30_CB3_ATV_SGR_up_Ellipticity_NM_OriginalSamplingRate_MaskExcluded/ellipse_parameters_Outlier(FittingError>1mm)Filtered_MeanSubsampled_dz0.25m_borehole_trajectory.csv"
                   "/Users/wangguangyu/Data/Geomechanics/BedrettoLab/Logs_MB4_20200604/2020_6_04_ATV_MB4_UP_full_run_Ellipticity_NM_OriginalSamplingRate_MaskExcluded/ellipse_parameters_Outlier(FittingError>1mm)Filtered_MeanSubsampled_dz0.25m_borehole_trajectory.csv" 
                   "/Users/wangguangyu/Data/Geomechanics/BedrettoLab/Logs_MB5_20210322/MB5_SGR_ABI_up_cent_20210322_Ellipticity_NM_OriginalSamplingRate_MaskExcluded/ellipse_parameters_Outlier(FittingError>1mm)Filtered_MeanSubsampled_dz0.25m_borehole_trajectory.csv" 
                   "/Users/wangguangyu/Data/Geomechanics/BedrettoLab/Logs_MB8_20210311/MB8_SGR_DEV_ATV_cent_up_20210311_Ellipticity_NM_OriginalSamplingRate_MaskExcluded/ellipse_parameters_Outlier(FittingError>1mm)Filtered_MeanSubsampled_dz0.25m_borehole_trajectory.csv" 
                   "/Users/wangguangyu/Data/Geomechanics/BedrettoLab/Logs_ST1_20210305/ST1_20210305_DEV_ATV_up_main_Ellipticity_NM_OriginalSamplingRate_MaskExcluded/ellipse_parameters_Outlier(FittingError>1mm)Filtered_MeanSubsampled_dz0.25m_borehole_trajectory.csv" 
                   "/Users/wangguangyu/Data/Geomechanics/BedrettoLab/Logs_ST2_20210525/ST2_20210525_ATV_up_Ellipticity_NM_OriginalSamplingRate_MaskExcluded/ellipse_parameters_Outlier(FittingError>1mm)Filtered_MeanSubsampled_dz0.25m_borehole_trajectory.csv"];

output_filename = ["/Users/wangguangyu/Data/Geomechanics/BedrettoLab/Misc/CB1_MajorAxisAzimuth_Outlier(FittingError>1mm)Filtered_MeanSubsampled_dz0.25m_StressInv_Depthwise_Window25m_HalfRange.mat" 
                    "/Users/wangguangyu/Data/Geomechanics/BedrettoLab/Misc/CB2_MajorAxisAzimuth_Outlier(FittingError>1mm)Filtered_MeanSubsampled_dz0.25m_StressInv_Depthwise_Window25m_HalfRange.mat" 
                    "/Users/wangguangyu/Data/Geomechanics/BedrettoLab/Misc/CB3_MajorAxisAzimuth_Outlier(FittingError>1mm)Filtered_MeanSubsampled_dz0.25m_StressInv_Depthwise_Window25m_HalfRange.mat"
                    "/Users/wangguangyu/Data/Geomechanics/BedrettoLab/Misc/MB4_MajorAxisAzimuth_Outlier(FittingError>1mm)Filtered_MeanSubsampled_dz0.25m_StressInv_Depthwise_Window25m_HalfRange.mat"
                    "/Users/wangguangyu/Data/Geomechanics/BedrettoLab/Misc/MB5_MajorAxisAzimuth_Outlier(FittingError>1mm)Filtered_MeanSubsampled_dz0.25m_StressInv_Depthwise_Window25m_HalfRange.mat"
                    "/Users/wangguangyu/Data/Geomechanics/BedrettoLab/Misc/MB8_MajorAxisAzimuth_Outlier(FittingError>1mm)Filtered_MeanSubsampled_dz0.25m_StressInv_Depthwise_Window25m_HalfRange.mat"
                    "/Users/wangguangyu/Data/Geomechanics/BedrettoLab/Misc/ST1_MajorAxisAzimuth_Outlier(FittingError>1mm)Filtered_MeanSubsampled_dz0.25m_StressInv_Depthwise_Window25m_HalfRange.mat"
                    "/Users/wangguangyu/Data/Geomechanics/BedrettoLab/Misc/ST2_MajorAxisAzimuth_Outlier(FittingError>1mm)Filtered_MeanSubsampled_dz0.25m_StressInv_Depthwise_Window25m_HalfRange.mat"];

dz = 25;  % Depth window.
nan_thres = 0.5; % If the proportion of NaN values in the window is higher than this threshold, will NOT do the inversion.
max_iteration = 100;
n_file = length(input_filenames);

for i_file = 1:n_file
    
    fprintf("Borehole: %d/%d\n", i_file, n_file);
    input_filename = input_filenames(i_file);
    output_filename = output_filenames(i_file);

    %% Prepare for the loop
    A = readmatrix(input_filename);
    z = A(:, 1);  % The measured depth.
    z_start = floor(min(z) / dz) * dz;  % Start of new measured depth.
    z_end = ceil(max(z) / dz) * dz;  % End of new measured depth.
    znew = z_start:dz:z_end;  % New measured depth.
    nz = length(znew);
    param = struct('zmid', cell(1, nz), ...
                   'zmin', cell(1, nz), ...
                   'zmax', cell(1, nz), ...
                   'Rank_Top40', cell(1, nz), ...
                   'Rank_Top40_all', cell(1, nz), ...
                   'a_range', cell(1, nz), ...
                   'b_range', cell(1, nz), ...
                   'c_range', cell(1, nz), ...
                   'phi_range', cell(1, nz), ...
                   'S3_range', cell(1, nz), ...
                   'RMSE_store', cell(1, nz), ...
                   'para_cnt', cell(1, nz));
    
    for iz = 1:nz
        %
        fprintf("Progress: %d/%d\n", iz, nz);
        
        % Range for searching.
        a_min = 0; a_max = 360; a_int = 45;
        b_min = -90; b_max = 0; b_int = 22.5;
        c_min = 0; c_max = 90; c_int = 22.5;
        phi_min = 0; phi_max = 1; phi_int = 0.25;
        S3_min = 0; S3_max = 1; S3_int = 0.25;
    
        % Define depth window.
        zmid = znew(iz);  
        zmin = max(znew(iz) - dz / 2, z_start);
        zmax = min(znew(iz) + dz / 2, z_end);
    
        % Get data in the window.
        condition = (z >= zmin) & (z <= zmax);
        major_ms = A(condition, 2);  % The measured major axis azimuths of borehole cross-sections.
        btilt = A(condition, 9);  % Measured borehole tilt.
        bazi = A(condition, 10);  % Measured borehole azimuth.
    
        % Calculate the proportion of NaN values in the window.
        major_nan = isnan(major_ms);
        nan_ratio = length(major_nan(major_nan == 1)) / length(major_nan);
        
        % If the proportion of NaN values in the window is lower than threshold, do the inversion.
        if nan_ratio <= 0.5
            major_fm = zeros(size(major_ms));  % To store foward-modeled major axis azimuths.
            n_sample = length(major_ms); % Number of samples.
            
            a_num = round((a_max-a_min)/a_int);
            b_num = round((b_max-b_min)/b_int);
            c_num = round((c_max-c_min)/c_int);
            phi_num = round((phi_max-phi_min)/phi_int);
            S3_num = round((S3_max-S3_min)/S3_int);
            total_cnt = a_num*b_num*c_num*phi_num*S3_num;
            
            a_range = zeros(total_cnt, max_iteration);
            b_range = zeros(total_cnt, max_iteration);
            c_range = zeros(total_cnt, max_iteration);
            phi_range = zeros(total_cnt, max_iteration);
            S3_range = zeros(total_cnt, max_iteration);
            %--------------------------------------------------------------------------
            para_cnt = 0;
            for i=1:a_num
                for j=1:b_num
                    for m=1:c_num
                        for n=1:phi_num
                            for h = 1:S3_num
                                para_cnt = para_cnt + 1;
                                a_range(para_cnt,1) = a_min + a_int*(i-1/2);
                                b_range(para_cnt,1) = b_min + b_int*(j-1/2);
                                c_range(para_cnt,1) = c_min + c_int*(m-1/2);
                                phi_range(para_cnt,1) = phi_min + phi_int*(n-1/2);
                                S3_range(para_cnt,1) = S3_min + S3_int*(h-1/2);
                            end
                        end
                    end
                end
            end
            %% Main loop for the optimal combination of stress parameters
            RMSE_store = zeros(total_cnt, max_iteration); % a, b, c, phi, MLE
            Rank_Top40_all = zeros([40, 6, max_iteration]);
            iteration_cnt = 0;
            while ((a_int > 0.5) && (iteration_cnt < max_iteration))
                iteration_cnt = iteration_cnt+1;
                %
                Trial_cnt = 0;
                for lr = 1 : length(a_range)
                    Trial_cnt = Trial_cnt + 1;
                    a_trial = a_range(lr,iteration_cnt);
                    b_trial = b_range(lr,iteration_cnt);
                    c_trial = c_range(lr,iteration_cnt);
                    phi_trial = phi_range(lr,iteration_cnt);
                    S3_trial = S3_range(lr,iteration_cnt);
                    % Compute borehole ellipticity
                    euler_trial = [a_trial, b_trial, c_trial];
                    for i = 1: n_sample
                        [major, ~] = EllipAxisOrien(phi_trial, ...
                                                    S3_trial, ...
                                                    euler_trial, ...
                                                    btilt(i), ...
                                                    bazi(i));
                        major_fm(i) = major;
                    end
                    % Compute RMSE between measured and modeled major axis azimuths.
                    RMSE = RMSE_azimuth(major_ms, major_fm);
                    % Store RMSE
                    RMSE_store(Trial_cnt,iteration_cnt) = RMSE;
                end
	            %
                % select top 40 combinations
                [~,Sort_Index] = sort(RMSE_store(:,iteration_cnt),'ascend');
                Rank_Top40 = [a_range(Sort_Index(1:40),iteration_cnt)...
                              b_range(Sort_Index(1:40),iteration_cnt)...
                              c_range(Sort_Index(1:40),iteration_cnt)...
                              phi_range(Sort_Index(1:40),iteration_cnt)...
                              S3_range(Sort_Index(1:40),iteration_cnt)...
                              RMSE_store(Sort_Index(1:40),iteration_cnt)];
                Rank_Top40_all(:, :, iteration_cnt) = Rank_Top40;
                %
	            % update parameter intervals
                a_int_new = (2/3)*a_int;
                b_int_new = (2/3)*b_int;
                c_int_new = (2/3)*c_int;
                phi_int_new = (2/3)*phi_int;
                S3_int_new = (2/3)*S3_int;
                
                Trial_cnt = 0;
                for ii = 1:2
                    for jj = 1:2
                        for mm = 1:2
                            for nn = 1:2
                                for hh = 1:2
                                    for kk = 1:40
                                        Trial_cnt = Trial_cnt+1;
                                        %
                                        a_range(Trial_cnt,iteration_cnt+1) = Rank_Top40(kk,1)-a_int+a_int_new*ii;
                                        if a_range(Trial_cnt,iteration_cnt+1) > a_max
                                            a_range(Trial_cnt,iteration_cnt+1) = a_max; % parameter should be within the reasonable range
                                        end
                                        if a_range(Trial_cnt,iteration_cnt+1) < a_min
                                            a_range(Trial_cnt,iteration_cnt+1) = a_min;
                                        end
                                        %      
                                        b_range(Trial_cnt,iteration_cnt+1) = Rank_Top40(kk,2)-b_int+b_int_new*jj;
                                        if b_range(Trial_cnt,iteration_cnt+1) > b_max
                                            b_range(Trial_cnt,iteration_cnt+1) = b_max;
                                        end
                                        if b_range(Trial_cnt,iteration_cnt+1) < b_min
                                            b_range(Trial_cnt,iteration_cnt+1) = b_min;
                                        end
                                        %
                                        c_range(Trial_cnt,iteration_cnt+1) = Rank_Top40(kk,3)-c_int+c_int_new*mm;
                                        if abs(b_range(Trial_cnt,iteration_cnt+1)-90)< 5 % assuming Sv is vertical
                                            c_range(Trial_cnt,iteration_cnt+1) = 0;
                                        end
                                        if c_range(Trial_cnt,iteration_cnt+1) > c_max
                                            c_range(Trial_cnt,iteration_cnt+1) = c_max;
                                        end
                                        if c_range(Trial_cnt,iteration_cnt+1) < c_min
                                            c_range(Trial_cnt,iteration_cnt+1) = c_min;
                                        end
                                        %
                                        phi_range(Trial_cnt,iteration_cnt+1) = Rank_Top40(kk,4)-phi_int+phi_int_new*nn;
                                        if phi_range(Trial_cnt,iteration_cnt+1) > phi_max
                                            phi_range(Trial_cnt,iteration_cnt+1) = phi_max;
                                        end
                                        if phi_range(Trial_cnt,iteration_cnt+1) < phi_min
                                            phi_range(Trial_cnt,iteration_cnt+1) = phi_min;
                                        end
                                        %
                                        S3_range(Trial_cnt,iteration_cnt+1) = Rank_Top40(kk,5)-S3_int+S3_int_new*hh;
                                        if S3_range(Trial_cnt,iteration_cnt+1) > S3_max
                                            S3_range(Trial_cnt,iteration_cnt+1) = S3_max;
                                        end
                                        if S3_range(Trial_cnt,iteration_cnt+1) < S3_min
                                            S3_range(Trial_cnt,iteration_cnt+1) = S3_min;
                                        end
                                        %
                                    end
                                end
                            end
                        end
                    end
                end
                %
                a_int = a_int_new;
                b_int = b_int_new;
                c_int = c_int_new;
                phi_int = phi_int_new;
                S3_int = S3_int_new;
            end
            
            %
            param(iz).zmid = zmid;
            param(iz).zmin = zmin;
            param(iz).zmax = zmax;
            param(iz).Rank_Top40 = Rank_Top40;
            param(iz).Rank_Top40_all = Rank_Top40_all;
            param(iz).a_range = a_range;
            param(iz).b_range = b_range;
            param(iz).c_range = c_range;
            param(iz).phi_range = phi_range;
            param(iz).S3_range = S3_range;
            param(iz).RMSE_store = RMSE_store;
            param(iz).para_cnt = para_cnt;
        
        % If the proportion of NaN values in the window is higher than the threshold, don't do the inversion. 
        else
            param(iz).zmid = zmid;
            param(iz).zmin = zmin;
            param(iz).zmax = zmax;
            param(iz).Rank_Top40 = NaN;
            param(iz).Rank_Top40_all = NaN;
            param(iz).a_range = NaN;
            param(iz).b_range = NaN;
            param(iz).c_range = NaN;
            param(iz).phi_range = NaN;
            param(iz).S3_range = NaN;
            param(iz).RMSE_store = NaN;
            param(iz).para_cnt = NaN;
        end
    end
    
    save(output_filename, 'param', '-v7.3');
end
