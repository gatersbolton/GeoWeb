# Copy this file to .env.agent.local and fill your values.
# python_service.app will auto-load .env.agent.local at startup.

GEO_AGENT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
GEO_AGENT_LLM_MODEL=qwen3.5-plus
GEO_AGENT_LLM_API_KEY=your_api_key_here

GEO_AGENT_LLM_TIMEOUT_SEC=60
GEO_AGENT_LLM_MAX_TOKENS=700
GEO_AGENT_LLM_TEMPERATURE=0.2
GEO_AGENT_LLM_LOG_ENABLED=true
# GEO_AGENT_LLM_LOG_PATH=C:/path/to/agent_llm_calls.jsonl
